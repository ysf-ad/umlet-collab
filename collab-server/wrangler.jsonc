{
	// Cloudflare deployment: npm run build && npx wrangler deploy (local: npx wrangler dev)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "umletino-collab",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "Room" }]
	},
	// SQLite-backed Durable Objects are the ones available on the Workers free plan
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
