{
	// Cloudflare deployment: npm run build && npx wrangler deploy (local: npx wrangler dev)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "umletino-collab",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	// served on the custom domain (Cloudflare creates the DNS record and certificate); workers.dev keeps working too
	"routes": [{ "pattern": "umlet.yousifaldakoki.com", "custom_domain": true }],
	"workers_dev": true,
	// MAX_PROJECTS_PER_IP: new projects one network (IP address) may create per 30 days.
	// TURNSTILE_SITE_KEY: the public key of a Cloudflare Turnstile widget (dashboard > Turnstile). The captcha only turns on once
	// its secret exists too: npx wrangler secret put TURNSTILE_SECRET. Optional: npx wrangler secret put QUOTA_SALT (random text
	// mixed into the hashed network addresses of the quota).
	"vars": { "MAX_PROJECTS_PER_IP": "5", "TURNSTILE_SITE_KEY": "" },
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ROOMS", "class_name": "Room" },
			{ "name": "PROJECTS", "class_name": "Project" },
			{ "name": "DIRECTORY", "class_name": "Directory" }
		]
	},
	// SQLite-backed Durable Objects are the ones available on the Workers free plan
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room"] },
		{ "tag": "v2", "new_sqlite_classes": ["Project", "Directory"] }
	]
}
