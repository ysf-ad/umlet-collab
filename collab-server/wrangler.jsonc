{
	// Cloudflare deployment: npm run build && npx wrangler deploy (local: npx wrangler dev)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "umletino-collab",
	"main": "src/worker.js",
	"compatibility_date": "2026-09-01",
	// served on the custom domain (Cloudflare creates the DNS record and certificate); workers.dev keeps working too
	"routes": [{ "pattern": "umlet.yousifaldakoki.com", "custom_domain": true }],
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ROOMS", "class_name": "Room" },
			{ "name": "PROJECTS", "class_name": "Project" },
			{ "name": "DIRECTORY", "class_name": "Directory" }
		]
	},
	// SQLite-backed Durable Objects are the ones available on the Workers free plan
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Room"] },
		{ "tag": "v2", "new_sqlite_classes": ["Project", "Directory"] }
	]
}
